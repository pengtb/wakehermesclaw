<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.ASK_OPENCLAW"
        app:queryPatterns="@array/ask_openclaw_query_patterns">
        <intent
            android:action="com.openclaw.assistant.action.ASK_OPENCLAW"
            android:targetPackage="com.openclaw.assistant"
            android:targetClass="com.openclaw.assistant.MainActivity">
            <parameter
                android:name="prompt"
                android:key="prompt"
                android:mimeType="https://schema.org/Text"
                android:required="true" />
        </intent>
    </capability>

    <!-- 桌面长按图标 / Nova 的手势-快捷方式里会出现这一条 -->
    <shortcut
        android:shortcutId="voice_chat"
        android:enabled="true"
        android:icon="@drawable/ic_qs_voice"
        android:shortcutShortLabel="@string/qs_tile_label"
        android:shortcutLongLabel="@string/qs_tile_subtitle_ready">
        <intent
            android:action="com.openclaw.assistant.action.VOICE_CHAT" />
    </shortcut>
</shortcuts>
